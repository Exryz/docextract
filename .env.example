# Copy this file to .env and configure your LLM API key.

# LLM Provider (any LiteLLM model string: gemini/..., openai/..., azure/..., ollama/...)
DOCEXTRACT_LLM_MODEL=gemini/gemini-3.5-flash
DOCEXTRACT_LLM_TEMPERATURE=0.0
DOCEXTRACT_LLM_TIMEOUT_S=60.0
DOCEXTRACT_MAX_REPAIR_ATTEMPTS=2
DOCEXTRACT_CONSISTENCY_SAMPLES=1

# Storage & Upload Limits
DOCEXTRACT_DATABASE_URL=sqlite:///.data/docextract.db
DOCEXTRACT_STORAGE_DIR=.data/storage
DOCEXTRACT_MAX_UPLOAD_BYTES=20971520
DOCEXTRACT_MAX_PAGES=25
DOCEXTRACT_TARGET_DPI=300

# Confidence & Validation Thresholds
DOCEXTRACT_MIN_FIELD_CONFIDENCE=0.75
DOCEXTRACT_ROUNDING_TOLERANCE=0.02

# Outbound Webhooks
DOCEXTRACT_WEBHOOK_URL=
DOCEXTRACT_WEBHOOK_SECRET=
DOCEXTRACT_WEBHOOK_MAX_RETRIES=3

# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
